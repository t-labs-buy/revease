# Keep build contexts small — exclude everything the images rebuild or don't need.
**/node_modules
**/.next
**/dist
**/*.tsbuildinfo

**/__pycache__
**/*.pyc
**/.venv
**/.ruff_cache
**/.mypy_cache
**/.pytest_cache

# Local runtime data (SQLite + media) — never bake into an image
data/
**/*.sqlite
**/*.sqlite3

# Secrets
.env
.env.local
.env.docker

# VCS / editor / OS
.git
.github
.DS_Store
.claude/settings.local.json

# Docs & non-runtime assets
*.md
