# RevEase — ivolve cloud runtime config. Copy to `.env` next to the compose file
# on the deploy host and `chmod 600` it; the real .env is never committed.
# Read by docker compose (host vars) and by the api + worker containers
# (REFRACT_-prefixed vars).
#
# Values with spaces must be quoted — build.sh sources this file with `. ./.env`,
# which docker compose's own parser tolerates but the shell does not.

# --- Images ---
# REGISTRY is the push/pull target in the host's private registry; IMAGE_NS is the
# short name the containers actually run under, so `docker ps` reads
# `revease:api-v1` rather than `localhost:5000/revease:api-v1`. build.sh applies
# both names to the same image id.
REGISTRY=localhost:5000/revease
IMAGE_NS=revease
TAG=v1

# --- Ports. Only 80, 443 and 8020 are open in this hosts security group, and
#     80/443 belong to nginx-proxy-manager, so everything enters on 8020. ---
PUBLIC_PORT=8020
API_DEBUG_PORT=8021

# --- Browser -> API base. BAKED INTO THE WEB IMAGE AT BUILD TIME:
#     changing it needs a web rebuild (./build.sh web), not just a restart. ---
WEB_API_BASE=http://13.204.129.141:8020/api
# The API must allow whatever origin the browser loads the UI from.
CORS_ORIGINS=http://13.204.129.141:8020

# --- Auth: token signing key. Generate once with
#       python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
#     and leave it alone — changing it logs everyone out. ---
REFRACT_AUTH_SECRET_KEY=
REFRACT_AUTH_TOKEN_TTL_HOURS=336
# Comma-separated emails that get the admin role on register/login (bootstrap
# admins). Admins see every user's projects and manage users at /admin/users.
REFRACT_ADMIN_EMAILS=
# Static key an external app sends as the X-Report-Key header to pull usage
# totals from GET /admin/usage/report. Leave empty to disable the endpoint.
REFRACT_USAGE_REPORT_KEY=

# --- AI: Claude step labeling / narration (optional; deterministic offline
#     labeler is used when empty) ---
REFRACT_ANTHROPIC_API_KEY=
REFRACT_ANTHROPIC_MODEL=claude-opus-4-8

# --- TTS (Kokoro is local + keyless; ~350MB model downloaded into the volume
#     on first worker start, set REFRACT_FETCH_KOKORO=0 to skip) ---
REFRACT_TTS_PROVIDER=kokoro
REFRACT_KOKORO_VOICE=af_sarah
REFRACT_PIPER_VOICE=en_US-lessac-medium
REFRACT_FETCH_KOKORO=1
REFRACT_OPENAI_API_KEY=

# --- Whisper transcription (worker image built with WHISPER=1) ---
REFRACT_WHISPER_MODEL=small
REFRACT_WHISPER_DEVICE=cpu
REFRACT_WHISPER_COMPUTE=int8
REFRACT_WHISPER_VOCAB="RevEase, Refract, Auto Record, Workflow Graph"
