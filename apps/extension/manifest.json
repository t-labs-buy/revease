{
  "manifest_version": 3,
  "name": "Refract Capture",
  "version": "0.1.0",
  "description": "Capture click/input/navigation telemetry + per-step screenshots into a Refract session, or Auto Record a tab with an AI driver.",
  "permissions": ["activeTab", "tabs", "storage", "scripting", "tabCapture", "offscreen", "debugger", "sidePanel"],
  "host_permissions": ["<all_urls>", "http://localhost:8000/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Refract Capture"
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  }
}
