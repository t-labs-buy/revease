# Copy to .env for the Docker stack:  cp .env.docker.example .env
# These are read by both the api and worker containers (REFRACT_-prefixed).

# --- Registry / image tag (used by docker-compose.prod.yml and shift.py) ---
REGISTRY=tlabsdoc/revease
TAG=latest

# --- Ports published on the host ---
WEB_PORT=3000
API_PORT=8000

# --- Browser -> API base (baked into the web image at build time) ---
# Same host / SSH tunnel: keep localhost. LAN or remote: use the host's IP/domain,
# then rebuild the web image (shift.py --api-base ... or compose build).
WEB_API_BASE=http://localhost:8000
# API CORS must allow whatever origin the browser loads the web UI from.
CORS_ORIGINS=http://localhost:3000

# --- AI: Claude step labeling / narration (optional; offline fallback otherwise) ---
REFRACT_ANTHROPIC_API_KEY=
REFRACT_ANTHROPIC_MODEL=claude-opus-4-8

# --- TTS voice (keyless local by default) ---
REFRACT_TTS_PROVIDER=kokoro
REFRACT_KOKORO_VOICE=af_sarah
REFRACT_PIPER_VOICE=en_US-lessac-medium
# Set 0 to skip the ~350MB Kokoro model download (worker falls back to Piper)
REFRACT_FETCH_KOKORO=1
# OpenAI TTS instead (needs a key + REFRACT_TTS_PROVIDER=openai)
REFRACT_OPENAI_API_KEY=

# --- Whisper transcription (image built with WHISPER=1) ---
REFRACT_WHISPER_MODEL=small       # tiny|base|small|medium|large-v3
REFRACT_WHISPER_DEVICE=cpu        # cpu | cuda
REFRACT_WHISPER_COMPUTE=int8      # int8 (cpu) | float16 (cuda)
REFRACT_WHISPER_VOCAB=            # comma-separated product/feature names, e.g. "RevEase, Auto Record"
