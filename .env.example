# Copy to .env and fill. All Refract config is REFRACT_-prefixed.

# --- Local persistence & media (defaults are fine for local dev) ---
# REFRACT_DATA_DIR=./data
# REFRACT_MEDIA_DIR=./data/media
# REFRACT_DATABASE_URL=            # empty -> sqlite in DATA_DIR

# --- Background jobs ---
REFRACT_REDIS_URL=redis://localhost:6379/0

# --- AI: Claude step labeling / narration (Phase 2+). ---
# Preferred: a direct Anthropic API key (sk-ant-...). Default model claude-opus-4-8.
REFRACT_ANTHROPIC_API_KEY=
REFRACT_ANTHROPIC_MODEL=claude-opus-4-8
# Alternative gateway: OpenRouter (sk-or-...). Used only if no Anthropic key is set.
# REFRACT_OPENROUTER_API_KEY=
# REFRACT_OPENROUTER_MODEL=anthropic/claude-opus-4.1
# OpenRouter *management* key (not an API key): shows total AI spend for a date
# range on the admin Usage page, read from OpenRouter's analytics API.
# REFRACT_OPENROUTER_MANAGEMENT_KEY=
# Name of the OpenRouter API key to report spend for (empty = whole workspace).
# REFRACT_OPENROUTER_COST_KEY=recease

# --- TTS voice (Phase 3), behind one TTSProvider adapter. ---
#   kokoro = high-quality keyless local neural TTS (default; run `make kokoro-model`)
#   piper  = lighter keyless local TTS (voice model auto-downloads ~63MB)
#   openai = OpenAI TTS (needs REFRACT_OPENAI_API_KEY)
REFRACT_TTS_PROVIDER=kokoro
REFRACT_KOKORO_VOICE=af_sarah
REFRACT_PIPER_VOICE=en_US-lessac-medium
REFRACT_OPENAI_API_KEY=
REFRACT_TTS_VOICE_ID=alloy

# --- Whisper transcription (Phase 2). Installed via `make install`
#     (uv sync --extra whisper). Model auto-downloads on first use. ---
REFRACT_WHISPER_MODEL=base       # tiny|base|small|medium|large-v3 (bigger = better + slower)
REFRACT_WHISPER_DEVICE=cpu       # set to "cuda" on the RTX 5070 for fast transcription
REFRACT_WHISPER_COMPUTE=int8     # int8 (cpu) | float16 (cuda)
REFRACT_WHISPER_VOCAB=           "Ivolve Devease"

# --- Media storage: local disk (default) or S3-compatible object storage ---
# s3 lets workers run on other machines (nothing shared but the bucket + DB).
# REFRACT_STORAGE_BACKEND=s3
# REFRACT_S3_ENDPOINT_URL=http://revease-minio:9000   # internal; empty for AWS S3
# REFRACT_S3_PUBLIC_URL=/s3                           # what browsers use (edge proxies /s3/)
# REFRACT_S3_BUCKET=revease-media
# REFRACT_S3_ACCESS_KEY=revease
# REFRACT_S3_SECRET_KEY=change-me-please
# REFRACT_S3_SERVE_MODE=redirect                      # redirect | proxy
# REFRACT_MEDIA_CACHE_MAX_GB=20                       # per-process local copies for ffmpeg
# REFRACT_UPLOAD_PART_MB=16                           # resumable upload part size

# --- Database: SQLite (default) or Postgres ---
# REFRACT_DATABASE_URL=postgresql+psycopg://revease:change-me-please@revease-postgres:5432/revease

# --- Retention (hourly, via Celery beat on the light worker; 0 disables a rule) ---
# REFRACT_RETENTION_ORIGINAL_DAYS=7        # browser WebM once source.mp4 exists
# REFRACT_RETENTION_AUDIO_DAYS=2           # transcription wav
# REFRACT_RETENTION_OLD_RENDERS_DAYS=7     # renders superseded by a newer one
# REFRACT_RETENTION_TTS_CACHE_DAYS=30
# REFRACT_RETENTION_STALE_UPLOADS_HOURS=24

# --- Heavy media processing (long recordings) ---
# Must exceed the longest task, or Redis redelivers it to a second worker slot.
# REFRACT_CELERY_VISIBILITY_TIMEOUT_S=43200
# REFRACT_PIPELINE_STALE_AFTER_S=180      # no heartbeat for this long = presumed dead
# REFRACT_MEDIA_THREADS=4                  # ffmpeg threads per job
# REFRACT_MEDIA_NORMALIZE_FPS=30
# REFRACT_MEDIA_NORMALIZE_PRESET=veryfast  # ultrafast = quicker, larger files
# REFRACT_MEDIA_NORMALIZE_TIMEOUT_S=21600

# --- Documentation (AI-written guide + per-step snapshots; generated by the worker) ---
# Frames are grabbed this long after a click so the pressed state shows and the
# recorder's start-up skew is absorbed. Snapshots are capped at this width.
# REFRACT_DOC_SNAPSHOT_CLICK_OFFSET_MS=150
# REFRACT_DOC_SNAPSHOT_MAX_WIDTH=1600
# REFRACT_DOC_LLM_TIMEOUT_S=180

# --- Web -> API ---
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- CORS (comma-separated) ---
REFRACT_CORS_ORIGINS=http://localhost:3000

# --- Auth (per-user spaces) ---
# Signing key for access tokens. Leave empty for local dev and a key is generated
# once into data/auth_secret.key. SET THIS EXPLICITLY anywhere real: without it,
# wiping data/ logs everyone out, and separate API instances won't accept each
# other's tokens. Generate one with:  openssl rand -base64 48
REFRACT_AUTH_SECRET_KEY=
# How long a login lasts before the user must sign in again (default 14 days).
REFRACT_AUTH_TOKEN_TTL_HOURS=336
# Comma-separated emails that get the admin role on register/login (bootstrap
# admins). Admins see every user's projects and can promote/demote other users
# from the Admin → Users page.
REFRACT_ADMIN_EMAILS=
# Restrict account creation to specific email domains (comma-separated, e.g. tarento.com).
# Leave empty to allow registration with any email domain.
REFRACT_AUTH_ALLOWED_EMAIL_DOMAIN=tarento.com

# --- Usage reporting ---
# Static key an external app sends as the X-Report-Key header to pull usage
# totals from GET /admin/usage/report. Leave empty to disable the endpoint.
REFRACT_USAGE_REPORT_KEY=
