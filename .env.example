# Copy to .env and fill. All Refract config is REFRACT_-prefixed.

# --- Local persistence & media (defaults are fine for local dev) ---
# REFRACT_DATA_DIR=./data
# REFRACT_MEDIA_DIR=./data/media
# REFRACT_DATABASE_URL=            # empty -> sqlite in DATA_DIR

# --- Background jobs ---
REFRACT_REDIS_URL=redis://localhost:6379/0

# --- AI: Claude step labeling / narration (Phase 2+). ---
# Preferred: a direct Anthropic API key (sk-ant-...). Default model claude-opus-4-8.
REFRACT_ANTHROPIC_API_KEY=
REFRACT_ANTHROPIC_MODEL=claude-opus-4-8
# Alternative gateway: OpenRouter (sk-or-...). Used only if no Anthropic key is set.
# REFRACT_OPENROUTER_API_KEY=
# REFRACT_OPENROUTER_MODEL=anthropic/claude-opus-4.1

# --- TTS voice (Phase 3), behind one TTSProvider adapter. ---
#   kokoro = high-quality keyless local neural TTS (default; run `make kokoro-model`)
#   piper  = lighter keyless local TTS (voice model auto-downloads ~63MB)
#   openai = OpenAI TTS (needs REFRACT_OPENAI_API_KEY)
REFRACT_TTS_PROVIDER=kokoro
REFRACT_KOKORO_VOICE=af_sarah
REFRACT_PIPER_VOICE=en_US-lessac-medium
REFRACT_OPENAI_API_KEY=
REFRACT_TTS_VOICE_ID=alloy

# --- Whisper transcription (Phase 2). Installed via `make install`
#     (uv sync --extra whisper). Model auto-downloads on first use. ---
REFRACT_WHISPER_MODEL=base       # tiny|base|small|medium|large-v3 (bigger = better + slower)
REFRACT_WHISPER_DEVICE=cpu       # set to "cuda" on the RTX 5070 for fast transcription
REFRACT_WHISPER_COMPUTE=int8     # int8 (cpu) | float16 (cuda)

# --- Web -> API ---
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- CORS (comma-separated) ---
REFRACT_CORS_ORIGINS=http://localhost:3000
